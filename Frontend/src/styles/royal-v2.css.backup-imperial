  margin:12px 0;
}
.regal-home .regal-hero__description {
  max-width:400px;font-size:12px;line-height:1.75;margin:12px 0;
}
.regal-home .regal-hero__actions {margin-top:16px;gap:11px;}
.regal-home .regal-hero__actions .regal-button {min-height:43px;padding:10px 18px;font-size:12px;}
.regal-home .regal-hero__signature {display:none;}
.regal-home .regal-hero__arch::after {
  background:
    linear-gradient(90deg,rgba(3,43,32,.96),rgba(5,46,35,.9) 23%,rgba(8,49,37,.62) 45%,rgba(6,35,28,.08) 73%),
    linear-gradient(0deg,rgba(5,37,27,.22),transparent 40%);
}
.regal-home .regal-hero__photo {
  width:100%;height:100%;object-fit:cover;object-position:center 50%;
  filter:saturate(1.18) sepia(.11) contrast(1.08);
}
.regal-home .regal-hero__ornaments::before {inset:12px;border-color:#d9bc8260;}
.regal-home .regal-cloud--top {left:10px;top:120px;width:240px;opacity:.55;}
.regal-home .regal-cloud--bottom {left:auto;right:0;bottom:8px;width:220px;opacity:.38;}
.regal-home .regal-ngo-mon {right:2%;bottom:10px;width:300px;opacity:.16;}
.regal-home .regal-hero__image-label {right:34px;bottom:25px;font-size:8px;}

/* STATS – khối nổi giấy cổ */
.regal-home .regal-stats {
  position:relative;z-index:7;
  max-width:950px;min-height:76px;
  margin-top:-30px;padding:12px 15px;
  border-radius:11px;
  background:linear-gradient(115deg,#fffaf0,#f5e8d1,#fffaf0);
  box-shadow:0 14px 32px #1637292b;
}
.regal-home .regal-stats__item {padding:5px 18px;gap:13px;}
.regal-home .regal-stats__icon {font-size:24px;}
.regal-home .regal-stats strong {font-size:31px;}
.regal-home .regal-stats p {font-size:10px;margin-top:4px;}

/* DANH SÁCH – luôn 3 thẻ đồng đều trên desktop */
.regal-home .regal-destinations {
  position:relative;max-width:1380px;
  padding:64px 5% 70px;
  isolation:isolate;
}
.regal-home .regal-destinations::before,
.regal-home .regal-destinations::after {
  content:'✧';position:absolute;z-index:-1;
  font:normal 150px var(--rg-serif);color:#cba4651d;pointer-events:none;
}
.regal-home .regal-destinations::before {left:-12%;top:120px;}
.regal-home .regal-destinations::after {right:-11%;bottom:65px;}
.regal-home .regal-section-heading {align-items:center;padding-bottom:22px;}
.regal-home .regal-section-heading h2 {
  font-size:clamp(32px,3vw,44px);line-height:1.2;margin:9px 0 0;
}
.regal-home .regal-section-heading > p {max-width:300px;font-size:11px;line-height:1.8;}
.regal-home .regal-filters {margin:16px 0 12px;}
.regal-home .regal-filter {padding:8px 13px;font-size:11px;}
.regal-home .regal-results {margin:0 0 14px;padding:9px 0;}
.regal-home .regal-grid {
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:22px;align-items:stretch;
}
.regal-home .regal-card,
.regal-home .regal-card--featured {
  grid-row:auto;grid-column:auto;display:flex;flex-direction:column;
  min-width:0;height:100%;border-radius:11px;
}
.regal-home .regal-card .regal-card__photo,
.regal-home .regal-card--featured .regal-card__photo {flex:none;width:100%;height:205px;}
.regal-home .regal-card .regal-card__body,
.regal-home .regal-card--featured .regal-card__body {
  padding:17px 19px 16px;display:flex;flex-direction:column;flex:1;
}
.regal-home .regal-card h3,
.regal-home .regal-card--featured h3 {font-size:24px;margin:7px 0 8px;}
.regal-home .regal-card .regal-card__body > p {
  min-height:0;flex:1;font-size:11.5px;line-height:1.65;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.regal-home .regal-card__footer {margin-top:13px;padding-top:11px;}
.regal-home .regal-card__footer > span {font-size:9px;}
.regal-home .regal-card__footer a {font-size:11px;}
.regal-home .regal-card__number {font-size:9px;}
.regal-home .regal-more {margin-top:26px;}
@media(min-width:981px) {
  /* Đã có tìm kiếm ở navbar; không cần thanh tìm kiếm thứ hai */
  .regal-home .regal-search {display:none;}
}

/* CTA – tối giản, nhìn rõ hơn như demo */
.regal-home .regal-journey {min-height:185px;padding:29px 10%;}
.regal-home .regal-journey h2 {font-size:clamp(30px,3vw,43px);margin:8px 0;}
.regal-home .regal-journey p {font-size:11px;margin-bottom:12px;}
.regal-home .regal-journey__seal {width:140px;height:140px;flex-basis:140px;}
.regal-home .regal-journey__seal span {font-size:44px;}
.regal-home .regal-footer {padding:28px 6%;}

/* BẢN ĐỒ – kiểu giấy cổ + danh sách thẻ ảnh như demo */
.hue-map-page .regal-map-header {height:78px;padding:0 3.5%;z-index:36;}
.hue-map-page .regal-map-header__brand strong {font-size:25px;}
.hue-map-page .regal-map-header__brand small {font-size:9px;}
.hue-map-page .royal-map-header__palace {
  display:grid;place-items:center;color:#cda869;
  padding:3px 13px;border-bottom:1px solid #d8b67960;
}
.hue-map-page .hue-map-sidebar {
  width:clamp(360px,29vw,445px);max-height:calc(100% - 98px);
  top:88px;left:12px;
}
.hue-map-page .hue-map-panel {
  padding:19px 18px 13px;
  border-radius:12px;
  background:linear-gradient(140deg,#fff9ed,#f6e9cf) !important;
  outline:1px solid #cba76b;outline-offset:-6px;
}
.hue-map-page .hue-map-home {margin-bottom:7px;}
.hue-map-page .hue-map-panel-heading {margin-bottom:14px;padding-bottom:10px;}
.hue-map-page .hue-map-panel-heading h2 {font-size:24px;}
.hue-map-page .hue-map-panel-heading p {font-size:11px;}
.hue-map-page .hue-map-control-details {display:flex;flex-direction:column;}
.hue-map-page .hue-map-actions {margin-top:16px;}
.hue-map-page .maplibregl-ctrl-top-right {top:90px;}
.hue-map-page .hue-map-canvas .maplibregl-canvas {filter:sepia(.12) saturate(.93) contrast(1.03);}

.royal-directory {font-family:var(--rg-body);color:#174436;}
.royal-directory__heading {display:flex;align-items:center;justify-content:space-between;gap:7px;margin:0 0 9px;}
.royal-directory__title {display:flex;align-items:center;gap:7px;color:#a77a3e;font-size:10px;font-weight:800;letter-spacing:1.2px;}
.royal-directory__heading small {color:#927956;font-size:10px;white-space:nowrap;}
.royal-directory__search {
  display:flex;align-items:center;gap:8px;height:42px;padding:0 11px;
  background:#fffdf8;border:1px solid #cfb17e;border-radius:10px;
}
.royal-directory__search:focus-within {box-shadow:0 0 0 3px #ceb37d35;}
.royal-directory__search > span {color:#a07843;font-size:27px;}
.royal-directory__search input {
  width:100%;min-width:0;font:500 12px var(--rg-body);background:transparent;
  border:0;outline:none;color:#174737;
}
.royal-directory__search button {border:0;background:transparent;color:#956e3f;font-size:23px;cursor:pointer;}
.royal-directory__filters {display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0 13px;}
.royal-directory__filters label {min-width:0;}
.royal-directory__filters select {
  width:100%;max-width:100%;min-width:0;
  padding:10px 24px 10px 9px;
  color:#1f4939;border:1px solid #d0ae77;border-radius:9px;
  background:#fffaf1;font:600 10px var(--rg-body);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;
}
.royal-directory__list {display:grid;gap:7px;}
.royal-directory__item {
  display:flex;align-items:center;gap:10px;min-width:0;min-height:67px;width:100%;
  padding:6px 7px;background:#fffaf0;border:1px solid #dec493;border-radius:10px;
  text-align:left;cursor:pointer;color:#1d4738;transition:border-color .18s,background .18s,box-shadow .18s;
}
.royal-directory__item:hover,.royal-directory__item.is-active {
  border-color:#aa8247;background:#f5e9d1;box-shadow:0 4px 10px #2a3e2a13;
}
.royal-directory__item img {
  flex:none;width:74px;height:54px;object-fit:cover;
  border:1px solid #cba96e;border-radius:6px;background:#e5d5ba;
}
.royal-directory__item-body {display:block;min-width:0;flex:1;}
.royal-directory__item-body strong {
  display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  font:700 15px/1.35 var(--rg-serif);
}
.royal-directory__item-body small {
  display:flex;align-items:center;gap:4px;min-width:0;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap;
  color:#84775f;font:500 9px/1.6 var(--rg-body);
}
.royal-directory__item-body small svg {color:#b28c4f;flex:none;}
.royal-directory__item-side {display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex:none;}
.royal-directory__distance {
  padding:3px 5px;border-radius:8px;background:#f4ead5;border:1px solid #e2c99a;
  color:#745731;font:700 9px var(--rg-body);white-space:nowrap;
}
.royal-directory__arrow {font-size:22px;color:#896b3a;line-height:1;}
.royal-directory__empty {padding:15px;text-align:center;color:#797464;font-size:11px;}
.royal-directory__more {
  width:100%;margin:9px 0 0;background:transparent;border:0;
  color:#926c3d;font:700 10px var(--rg-body);cursor:pointer;
}
.royal-directory__all {
  display:flex;align-items:center;justify-content:center;gap:10px;width:100%;
  padding:12px;margin:12px 0 3px;
  border-radius:999px;border:1px solid #d9bd86;
  background:linear-gradient(110deg,#0b553e,#063526);color:#fff0c9;
  font:700 12px var(--rg-body);cursor:pointer;
  box-shadow:0 5px 13px #13432e2d;
}
.royal-directory__all:disabled {opacity:.55;cursor:not-allowed;}
.royal-directory__footnote {margin:5px 0 0;color:#927e62;font-size:9px;line-height:1.5;text-align:center;}

/* Chú thích từ dữ liệu thật, không vẽ nhãn/giá giả trên bản đồ */
.royal-map-legend {
  position:absolute;right:20px;top:41%;z-index:13;
  width:235px;padding:0 13px 12px;
  border:2px solid #b99256;border-radius:13px;
  background:linear-gradient(135deg,#fffaf0,#f4e7d0);
  color:#204637;box-shadow:0 12px 28px #1f47332b;
}
.royal-map-legend h3 {
  margin:0 -13px 11px;padding:12px;
  background:#0c4433;border-bottom:1px solid #bd985b;border-radius:11px 11px 0 0;
  color:#ffe5b3;text-align:center;font:700 15px var(--rg-serif);
}
.royal-map-legend__row {display:flex;gap:9px;align-items:center;font-size:10px;margin:9px 0;}
.royal-map-legend__row > span:nth-child(2) {flex:1;}
.royal-map-legend__row strong {color:#98713e;}
.royal-map-legend__symbol {
  display:grid;place-items:center;width:24px;height:24px;border-radius:50%;
  background:#104b37;color:#eed39d;border:1px solid #d9bb86;
}
.royal-map-legend__circle {width:20px;height:20px;border-radius:50%;border:2px dashed #c3a06c;background:#dabc8e38;}
.royal-map-legend p {font-size:10px;color:#837967;}

/* Popup có ảnh nằm ngang – chỉ hiển thị khi chọn POI */
.hue-map-page .hue-poi-sheet {
  width:min(775px,calc(100% - 515px));
  display:grid;grid-template-columns:40% minmax(0,60%);
  border:2px solid #bd975f;bottom:20px;right:20px;
  background:#fff9ec;box-shadow:0 16px 46px #103d2e52;
}
.hue-map-page .hue-poi-sheet-photo {height:100%;min-height:225px;}
.hue-map-page .hue-poi-sheet-body {padding:22px 22px 17px;}
.hue-map-page .hue-poi-sheet h3 {font-size:26px;}

/* Responsive */
