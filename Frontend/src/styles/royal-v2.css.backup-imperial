
@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap');

:root {
  --rg-deep: #072f26;
  --rg-green: #104a3a;
  --rg-green-2: #1d604b;
  --rg-gold: #cda768;
  --rg-gold-light: #edd29d;
  --rg-paper: #f7efe1;
  --rg-ivory: #fffaf1;
  --rg-text: #173d30;
  --rg-muted: #657568;
  --rg-line: #ddc7a2;
  --rg-serif: 'Playfair Display', Georgia, serif;
  --rg-body: 'Be Vietnam Pro', system-ui, sans-serif;
}

/* ================================
   TRANG CHỦ – HOÀNG CUNG HUẾ
================================ */

.regal-home {
  color: var(--rg-text);
  font-family: var(--rg-body);
  min-height: 100vh;
  background:
    radial-gradient(circle at 7% 26%, #e0c59c30, transparent 31%),
    radial-gradient(circle at 94% 65%, #bac8ac2e, transparent 35%),
    repeating-linear-gradient(0deg, #724c2005 0 1px, transparent 1px 5px),
    var(--rg-paper);
}

.regal-home *,
.regal-map-header *,
.regal-map-search * {
  box-sizing: border-box;
}

.regal-home button,
.regal-map-search button {
  cursor: pointer;
  font-family: inherit;
}

.regal-home a {
  text-decoration: none;
}

/* HEADER */
.regal-navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 83px;
  padding: 0 max(5%, calc((100% - 1390px) / 2));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  background:
    radial-gradient(circle at 0 0, #bfa05b1b, transparent 25%),
    linear-gradient(110deg, #062920, #0d4535 68%, #062d25);
  border-bottom: 1px solid #d8b979a0;
  box-shadow: 0 10px 28px #082b2340;
}

.regal-brand,
.regal-map-header__brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.regal-brand__emblem,
.regal-map-header__logo {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  font: 700 27px var(--rg-serif);
  color: #163d31;
  background: linear-gradient(140deg, #fbe5b6, #bb914b);
  border: 1px solid #f4db9d;
  box-shadow: 0 4px 16px #0003;
}

.regal-brand strong,
.regal-map-header__brand strong {
  display: block;
  color: #fff9ea;
  font: 700 26px var(--rg-serif);
  letter-spacing: .5px;
  white-space: nowrap;
}

.regal-brand strong i,
.regal-map-header__brand em {
  color: #ecca8f;
  font-style: normal;
}

.regal-brand small,
.regal-map-header__brand small {
  display: block;
  margin-top: 3px;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.9px;
  color: #d8c4a2;
}

.regal-navbar__links {
  display: flex;
  align-items: center;
  gap: clamp(18px, 3vw, 43px);
}

.regal-navbar__links a {
  position: relative;
  color: #efe6d5;
  font-size: 13px;
  font-weight: 700;
  padding: 12px 0;
}

.regal-navbar__links a:hover,
.regal-navbar__links a.is-current {
  color: #f3d497;
}

.regal-navbar__links a.is-current::after {
  content: '';
  position: absolute;
  bottom: 3px;
  left: 26%;
  right: 26%;
  height: 2px;
  background: #e8c17e;
}

.regal-navbar__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  background: #ffffff0c;
  border: 1px solid #dab477;
  border-radius: 9px;
  padding: 12px 19px;
  color: #f5dfba;
  font-size: 12px;
  font-weight: 700;
}

.regal-navbar__cta:hover {
  background: #d4aa65;
  color: var(--rg-deep);
}

/* HERO */
.regal-hero {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 15% 75%, #426f512f, transparent 38%),
    radial-gradient(circle at 95% 9%, #c69d4923, transparent 40%),
    linear-gradient(125deg, #072a22, #0d4637 56%, #082d25);
  border-bottom: 2px solid var(--rg-gold);
}

.regal-hero::before {
  content: '';
  position: absolute;
  inset: 18px;
  border: 1px solid #d6b37340;
  pointer-events: none;
}

.regal-hero::after {
  content: '';
  position: absolute;
  width: 340px;
  height: 340px;
  border: 2px solid #bfa5682e;
  box-shadow: 0 0 0 15px #bfa5680c, 0 0 0 32px #bfa56808;
  border-radius: 50%;
  top: -170px;
  left: -145px;
  pointer-events: none;
}

.regal-hero__inner {
  max-width: 1440px;
  margin: auto;
  min-height: 625px;
  padding: 55px 6% 70px;
  display: grid;
  grid-template-columns: 49% 51%;
  align-items: center;
  gap: 10px;
}

.regal-hero__copy {
  position: relative;
  z-index: 2;
  padding: 18px 0;
}

.regal-eyebrow {
  color: #e6bd78;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
}

.regal-eyebrow span {
  display: inline-block;
  padding: 0 8px;
}

.regal-hero h1 {
  margin: 25px 0 10px;
  color: #fff9ec;
  font: 700 clamp(43px, 5vw, 73px)/1.16 var(--rg-serif);
  letter-spacing: -1.5px;
  text-shadow: 0 5px 24px #00150f77;
}

.regal-hero h1 span {
  color: #ecd098;
}

.regal-hero__quote {
  margin: 19px 0;
  color: #e7bb77;
  font: italic 500 clamp(19px, 2.1vw, 28px)/1.55 var(--rg-serif);
}

.regal-hero__description {
  max-width: 520px;
  color: #e8e6d8;
  font-size: 14px;
  line-height: 2;
}

.regal-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
  margin-top: 28px;
}

.regal-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 13px;
  min-height: 48px;
  padding: 12px 24px;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 700;
  transition: transform .2s, background .2s, box-shadow .2s;
}

.regal-button:hover {
  transform: translateY(-2px);
}

.regal-button--gold {
  color: #14382d;
  background: linear-gradient(135deg, #f6dda6, #c89b56);
  border: 1px solid #f3dbab;
  box-shadow: 0 8px 22px #0002;
}

.regal-button--outline {
  color: #fff3dc;
  background: #ffffff08;
  border: 1px solid #d5b375;
}

.regal-button--outline:hover {
  background: #ffffff16;
}

.regal-hero__signature {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-top: 40px;
  color: #d7c5a1;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.regal-signature-line {
  width: 42px;
  height: 1px;
  background: #d7b777;
}

/* Khung ảnh cung điện */
.regal-hero__visual {
  position: relative;
  height: 100%;
  min-height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px 5px 20px 15px;
}

.regal-hero__arch {
  position: relative;
  width: min(100%, 620px);
  height: 510px;
  overflow: hidden;
  border: 3px solid #d0aa67;
  border-radius: 48% 48% 15px 15px / 29% 29% 15px 15px;
  background:
    linear-gradient(0deg, #082e26c5, transparent 35%),
    url('../assets/hero.png') center / cover no-repeat,
    linear-gradient(135deg, #b6ab82, #31604c);
  box-shadow:
    0 0 0 8px #d4ae6830,
    0 25px 65px #0007;
}

.regal-hero__arch::before {
  content: '';
  position: absolute;
  inset: 11px;
  border: 1px solid #f8deb88a;
  border-radius: inherit;
  pointer-events: none;
}

.regal-hero__image-label {
  position: absolute;
  bottom: 24px;
  left: 27px;
  color: #fff9e6;
  letter-spacing: 2.3px;
  font-size: 10px;
  font-weight: 700;
}

.regal-hero__visual-orbit {
  position: absolute;
  width: 135px;
  height: 135px;
  right: -17px;
  bottom: 12px;
  border-radius: 50%;
  border: 1px solid #e1ba77;
  box-shadow: inset 0 0 0 12px #dcb6751b;
  pointer-events: none;
}

/* Dải thống kê */
.regal-stats {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  max-width: 1200px;
  margin: -32px auto 0;
  padding: 23px 26px;
  background: linear-gradient(110deg, #fffaf1, #f2e5ce, #fffaf1);
  border: 1px solid #cda86d;
  border-radius: 18px;
  box-shadow: 0 15px 38px #1b392d25;
}

.regal-stats__item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  padding: 8px 17px;
  border-right: 1px solid #d4b887;
}

.regal-stats__item:last-child { border-right: 0; }

.regal-stats__icon {
  color: #ad8046;
  font-size: 28px;
  line-height: 1;
}

.regal-stats strong {
  font: 700 38px/1 var(--rg-serif);
  color: #0c4536;
}

.regal-stats p {
  font-size: 12px;
  margin-top: 7px;
  color: #6c7161;
  font-weight: 600;
}

/* DANH SÁCH DI TÍCH */
.regal-destinations {
  max-width: 1370px;
  margin: auto;
  padding: 100px 5% 110px;
  scroll-margin-top: 90px;
}

.regal-section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 45px;
  padding-bottom: 28px;
  border-bottom: 1px solid #d5bd94;
}

.regal-eyebrow--dark { color: #a07842; }

.regal-section-heading h2 {
  margin-top: 14px;
  color: #113f32;
  font: 700 clamp(34px, 3.5vw, 52px)/1.22 var(--rg-serif);
}

.regal-section-heading h2 em {
  color: #a8763e;
  font-weight: 500;
}

.regal-section-heading > p {
  max-width: 355px;
  color: var(--rg-muted);
  font-size: 13px;
  line-height: 1.95;
}

/* TÌM KIẾM */
.regal-search {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-top: 30px;
  padding: 9px;
  background: #fffaf2;
  border: 1px solid #d8c09a;
  border-radius: 15px;
  box-shadow: 0 12px 35px #092f2213;
}

.regal-search__icon {
  padding-left: 15px;
  font-size: 31px;
  color: #af834b;
}

.regal-search input {
  flex: 1;
  min-width: 0;
  padding: 12px 5px;
  border: none;
  outline: none;
  background: transparent;
  font: 500 14px var(--rg-body);
  color: #214a3d;
}

.regal-search__clear {
  border: none;
  color: #926f4a;
  background: transparent;
  font-size: 24px;
}

.regal-search__submit {
  align-self: stretch;
  padding: 0 24px;
  color: #fff8e8;
  background: #0c4636;
  border: 1px solid #0c4636;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 700;
}

.regal-search__submit:hover { background: #20614b; }

.regal-filters {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 15px;
  margin: 27px 0 22px;
}

.regal-filters__categories {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.regal-filter {
  padding: 10px 16px;
  border: 1px solid #d7be95;
  border-radius: 999px;
  background: #fffaf1;
  color: #224d3f;
  font-size: 12px;
  font-weight: 700;
}

.regal-filter:hover,
.regal-filter.is-active {
  color: #fff9e9;
  background: #0d4738;
  border-color: #0d4738;
}

.regal-results {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 17px 0;
  margin-bottom: 17px;
  border-top: 1px solid #dfc9a5;
  color: #74766a;
  font-size: 12px;
}

.regal-results strong { color: #0d4b39; }
.regal-results span:last-child { letter-spacing: 1.9px; }

/* CARD DI TÍCH */
.regal-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 27px;
}

.regal-card {
  min-width: 0;
  overflow: hidden;
  background: #fffaf2;
  border: 1px solid #d9c39e;
  border-radius: 16px;
  box-shadow: 0 13px 36px #193d2d17;
  transition: transform .25s, box-shadow .25s;
}

.regal-card:hover {
  transform: translateY(-7px);
  box-shadow: 0 24px 48px #11382725;
}

.regal-card__photo {
  position: relative;
  height: 240px;
  overflow: hidden;
  background: #c5c9b0;
}

.regal-card__photo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s;
}

.regal-card:hover .regal-card__photo img {
  transform: scale(1.06);
}

.regal-card__photo::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, #0a282060, transparent 45%, #09282024);
}

.regal-card__number {
  position: absolute;
  z-index: 2;
  left: 17px;
  top: 17px;
  border: 1px solid #e0c38e;
  border-radius: 7px;
  padding: 6px 10px;
  color: #fce7b6;
  background: #0c372bbd;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.regal-card__heart {
  position: absolute;
  z-index: 2;
  right: 16px;
  top: 15px;
  width: 37px;
  height: 37px;
  border: 1px solid #dfc38c;
  border-radius: 50%;
  background: #fffaf0eb;
  color: #164736;
  font-size: 23px;
}

.regal-card__heart.is-saved {
  color: #fff;
  background: #9d3c32;
}

.regal-card__body { padding: 22px 23px; }

.regal-card__category {
  color: #a2763f;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .2px;
}

.regal-ornament { margin-right: 5px; }

.regal-card h3 {
  margin: 11px 0;
  color: #113f32;
  font: 700 24px/1.3 var(--rg-serif);
}

.regal-card__body > p {
  color: #667567;
  font-size: 12.5px;
  line-height: 1.85;
  min-height: 70px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.regal-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid #e6d8c2;
}

.regal-card__footer > span {
  color: #8d8876;
  font-size: 10px;
  line-height: 1.5;
}

.regal-card__footer a {
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 700;
  color: #14503d;
}

.regal-card__footer a:hover { text-decoration: underline; }

.regal-more { margin-top: 45px; text-align: center; }

.regal-more button,
.regal-empty button {
  padding: 13px 28px;
  border: 1px solid #cda767;
  border-radius: 9px;
  background: #104b3a;
  color: #fff9eb;
  font-weight: 700;
}

.regal-empty {
  padding: 65px 20px;
  border: 1px dashed #c9a970;
  border-radius: 14px;
  background: #fffaef;
  text-align: center;
}

.regal-empty h3 {
  font: 700 25px var(--rg-serif);
  margin-bottom: 10px;
}

.regal-empty p { margin-bottom: 20px; color: var(--rg-muted); }

.regal-skeleton {
  height: 380px;
  border-radius: 16px;
  background: linear-gradient(110deg, #eee4d3 25%, #faf6ec 45%, #eee4d3 65%);
  background-size: 200% 100%;
  animation: regalShimmer 1.4s linear infinite;
}

@keyframes regalShimmer {
  to { background-position-x: -200%; }
}

.regal-alert {
  padding: 13px 16px;
  margin-bottom: 25px;
  color: #754c1d;
  background: #fff0cf;
  border: 1px solid #e2c18c;
  border-radius: 10px;
}

/* BANNER CUỐI TRANG */
.regal-journey {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 45px;
  min-height: 340px;
  padding: 60px max(7%, calc((100% - 1230px) / 2));
  background:
    radial-gradient(circle at 85% 45%, #d1b26d2f, transparent 33%),
    linear-gradient(130deg, #062b24, #18533f);
  color: #fff8e9;
  border-block: 2px solid #c9a269;
  overflow: hidden;
}

.regal-journey__copy { position: relative; z-index: 1; }

.regal-journey__copy > span {
  color: #e7be80;
  letter-spacing: 2px;
  font-size: 11px;
}

.regal-journey h2 {
  margin: 17px 0;
  font: 700 clamp(32px, 4vw, 50px)/1.25 var(--rg-serif);
}

.regal-journey h2 em { color: #eac78c; }

.regal-journey p {
  max-width: 500px;
  margin-bottom: 25px;
  font-size: 13px;
  color: #e2e5d8;
  line-height: 1.9;
}

.regal-journey__seal {
  flex: 0 0 230px;
  width: 230px;
  height: 230px;
  border: 1px solid #cda76b;
  outline: 1px solid #cda76b77;
  outline-offset: -16px;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #e6ca94;
}

.regal-journey__seal span { font-size: 75px; }
.regal-journey__seal small { letter-spacing: 4px; }

.regal-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  flex-wrap: wrap;
  padding: 40px 6%;
  color: #ddd8c3;
  background: #06261f;
}

.regal-footer strong {
  font: 700 25px var(--rg-serif);
  color: #fff9eb;
}

.regal-footer strong span { color: #e6c386; }
.regal-footer p { margin-top: 6px; font-size: 12px; }

.regal-footer nav { display: flex; gap: 20px; flex-wrap: wrap; }

.regal-footer nav a {
  color: #e4decf;
  font-size: 12px;
}

.regal-footer nav a:hover { color: #e9c485; }
.regal-footer small { color: #aaa997; }

/* ================================
   GIAO DIỆN BẢN ĐỒ HOÀNG CUNG
================================ */

.hue-map-page {
  --lacquer-dark: #0a3d30;
  --lacquer-panel: #fff9ed;
  --cinnabar: #a4763c;
  --gold: #c9a36b;
  --parchment-text: #194535;
  --parchment-muted: #68796a;
  background: #e1dfc8;
  font-family: var(--rg-body);
}

.hue-map-page::after {
  border: 1px solid #d3af73;
  box-shadow: inset 0 0 0 3px #fff3dd33;
}

.hue-map-canvas .maplibregl-canvas {
  filter: sepia(.15) saturate(.82) brightness(1.02);
}

/* Header bản đồ */
.regal-map-header {
  position: absolute;
  inset: 0 0 auto;
  z-index: 36;
  height: 77px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 0 max(4%, calc((100% - 1400px) / 2));
  border-bottom: 2px solid #cda56b;
  color: #fff7e6;
  background: linear-gradient(100deg, #062c23, #104536 70%, #082f27);
  box-shadow: 0 7px 25px #062d2547;
}

.regal-map-header__brand { text-decoration: none; }

.regal-map-header__nav {
  display: flex;
  align-items: center;
  gap: 26px;
}

.regal-map-header__nav a,
.regal-map-header__nav span {
  text-decoration: none;
  color: #f1e8d7;
  font-size: 13px;
  font-weight: 700;
}

.regal-map-header__nav .is-active {
  color: #f0d19a;
  border: 1px solid #d9b577;
  border-radius: 30px;
  padding: 9px 18px;
  background: #ffffff0b;
}

.regal-map-header__language {
  color: #e9ce99;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

/* Panel điều khiển */
.hue-map-page .hue-map-sidebar {
  top: 95px;
  left: 18px;
  width: min(365px, calc(100% - 85px));
  max-height: calc(100% - 110px);
  z-index: 16;
}

.hue-map-page .hue-map-panel,
.hue-map-page .hue-simulator,
.hue-map-page .hue-map-entered {
  background:
    radial-gradient(circle at 100% 0, #e7cb9d60, transparent 45%),
    linear-gradient(140deg, #fffaf0, #f4e7d0) !important;
  color: #1a4436;
  border: 1px solid #cba56e;
  outline: 1px solid #cfad7c77;
  outline-offset: -5px;
  border-radius: 19px;
  box-shadow: 0 15px 40px #113a2d3c;
}

