/* Hiệu ứng cuộn, chỉ chạy khi trình duyệt hỗ trợ */
@media (prefers-reduced-motion: no-preference) {
  .regal-home .regal-reveal {
    opacity: 0;
    transform: translateY(23px);
    transition:
      opacity .68s ease,
      transform .68s cubic-bezier(.2,.7,.2,1);
    transition-delay: var(--rg-delay, 0ms);
  }

  .regal-home .regal-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .regal-home .regal-card.regal-reveal.is-visible:hover {
    transform: translateY(-7px);
  }

  .regal-home .regal-hero__photo {
    animation: regalHeroZoom 28s ease-in-out infinite alternate;
  }

  .regal-home .regal-hero__copy {
    animation: regalHeroText .85s ease-out both;
  }

  @keyframes regalHeroZoom {
    from { transform: scale(1); }
    to { transform: scale(1.075); }
  }

  @keyframes regalHeroText {
    from {
      opacity: 0;
      transform: translateY(19px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}

